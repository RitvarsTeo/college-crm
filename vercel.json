{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "regions": [
    "fra1"
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/api/tc/go/demo/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/api/tc/go/letter/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/brand/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; style-src 'unsafe-inline'; img-src data:; sandbox"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{src,config}/**",
      "maxDuration": 60
    },
    "api/cron/*.js": {
      "includeFiles": "{src,config,lib}/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sis-sync",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/pbx-calls",
      "schedule": "* 5-15 * * *"
    },
    {
      "path": "/api/cron/gmail-poll",
      "schedule": "*/10 5-15 * * *"
    },
    {
      "path": "/api/cron/lead-answers",
      "schedule": "45 5 * * *"
    },
    {
      "path": "/api/cron/sheet-pull",
      "schedule": "0 * * * *"
    }
  ]
}
