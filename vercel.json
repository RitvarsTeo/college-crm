{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{src,config}/**",
      "maxDuration": 60
    }
  },
  "redirects": [
    { "source": "/src/:path*", "destination": "/not-public", "permanent": false },
    { "source": "/config/:path*", "destination": "/not-public", "permanent": false },
    { "source": "/lib/:path*", "destination": "/not-public", "permanent": false },
    { "source": "/sql/:path*", "destination": "/not-public", "permanent": false },
    { "source": "/.gitattributes", "destination": "/not-public", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
