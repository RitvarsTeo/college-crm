# College CRM - server-side only. Nothing here belongs in client code, in a
# browser URL, in git, or in a screenshot. Copy to .env and fill in locally;
# on Vercel these are project environment variables.

# The tg.lv PBX. Authentication is a URL query parameter because that is the
# only method the API accepts. The token unlocks caller numbers and recording
# links, so it is Tier 2 and server-side only.
PBX_API_TOKEN=

# Supabase. SUPABASE_SERVICE_KEY is the name the other Novikontas hubs use;
# SUPABASE_SERVICE_ROLE_KEY is accepted as an alias so either works.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Guards the public cron route. Vercel sends it as
# Authorization: Bearer <CRON_SECRET> on a scheduled invocation.
CRON_SECRET=

# --- Channels -------------------------------------------------------------
# Every channel is OFF until its mode is set to live. Set the secret first,
# then the mode. A channel with a live mode and no secret refuses to start.

# Website form - shared_secret_header
WEBSITE_FORM_SECRET=
# Google Form - shared_secret_header
GOOGLE_FORM_SECRET=
# Email - service_account_with_domain_delegation
GMAIL_SERVICE_ACCOUNT_JSON=
# Facebook - meta_app_secret_signature
META_APP_SECRET=
# Mailchimp - secret_in_url
MAILCHIMP_WEBHOOK_SECRET=
# Open Day - shared_secret_header
OPEN_DAY_SECRET=
# Agent or partner - per_partner_token
AGENT_TOKENS=

# Modes: off | test | live
CHANNEL_MODE_WEBSITE=off
CHANNEL_MODE_GOOGLE_FORM=off
CHANNEL_MODE_GMAIL=off
CHANNEL_MODE_FACEBOOK=off
CHANNEL_MODE_MESSENGER=off
CHANNEL_MODE_INSTAGRAM=off
CHANNEL_MODE_WHATSAPP=off
CHANNEL_MODE_MAILCHIMP=off
CHANNEL_MODE_OPEN_DAY=off
CHANNEL_MODE_PHONE=off
CHANNEL_MODE_AGENT=off

# Where the real database file lives, and the clean snapshot used to restore it.
CRM_DB=
CRM_SNAPSHOT=
