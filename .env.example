# College CRM - server-side only. Nothing here belongs in client code, in a
# browser URL, in git, or in a screenshot. Copy to .env and fill in locally;
# on Vercel these are project environment variables.

# The tg.lv PBX. Authentication is a URL query parameter because that is the
# only method the API accepts. The token unlocks caller numbers and recording
# links, so it is Tier 2 and server-side only.
PBX_API_TOKEN=

# Supabase. SUPABASE_SERVICE_KEY is the name the other Novikontas hubs use;
# SUPABASE_SERVICE_ROLE_KEY is accepted as an alias so either works.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Guards the public cron route. Vercel sends it as
# Authorization: Bearer <CRON_SECRET> on a scheduled invocation.
CRON_SECRET=

# --- Channels -------------------------------------------------------------
# Every channel is OFF until its mode is set to live. Set the secret first,
# then the mode. A channel with a live mode and no secret refuses to start.

# Website form - shared_secret_header
WEBSITE_FORM_SECRET=
# Google Form - shared_secret_header
GOOGLE_FORM_SECRET=
# Email - service_account_with_domain_delegation
GMAIL_SERVICE_ACCOUNT_JSON=
# Facebook - meta_app_secret_signature
META_APP_SECRET=
# Meta's webhook verification. WE choose this value; it is typed into the app at
# developers.facebook.com and Meta sends it back on the GET handshake before it
# will save the subscription. Without it no Meta channel can be connected at all.
META_VERIFY_TOKEN=
# Mailchimp - secret_in_url
MAILCHIMP_WEBHOOK_SECRET=
# Open Day - shared_secret_header
OPEN_DAY_SECRET=
# Agent or partner - per_partner_token
AGENT_TOKENS=

# Modes: off | test | live
CHANNEL_MODE_WEBSITE=off
CHANNEL_MODE_GOOGLE_FORM=off
CHANNEL_MODE_GMAIL=off
CHANNEL_MODE_FACEBOOK=off
CHANNEL_MODE_MESSENGER=off
CHANNEL_MODE_INSTAGRAM=off
CHANNEL_MODE_WHATSAPP=off
CHANNEL_MODE_MAILCHIMP=off
CHANNEL_MODE_OPEN_DAY=off
CHANNEL_MODE_PHONE=off
CHANNEL_MODE_AGENT=off

# Where the real database file lives, and the clean snapshot used to restore it.
CRM_DB=
CRM_SNAPSHOT=

# --- Sign-in --------------------------------------------------------------
# Added 25.09.2026 with the real login. Until CRM_AUTH is on, the CRM still
# identifies people by the `x-acting-as` header the browser sets, which is a
# setting and not a check.

# 1 or true turns real sign-in on. OFF by default.
CRM_AUTH=

# The key sessions are signed with. At least 24 characters, and the server
# REFUSES TO START if CRM_AUTH is on without it. Generate one with:
#   node scripts/manage_users.mjs secret
# Changing it signs everybody out, which is the point of having it.
CRM_SESSION_SECRET=

# --- Account provisioning ------------------------------------------------
# ONLY for a deployment whose database does not survive a restart - the V1
# testing copy keeps CRM_DB in /tmp, so crm_users is empty on every boot and a
# login screen would otherwise stand in front of no accounts at all.
#
# src/bootstrap.js reads these at startup and creates ONLY the addresses written
# down in config/prototype.json -> accounts. It never invents an account, never
# touches one that already exists, and never creates one it cannot give a
# password to.
#
# Set ALL of them or NONE. None means the copy provisions its accounts some
# other way and bootstrap stays out of it; some means somebody meant to use it
# and got it wrong, and the server refuses to start rather than half provision.
#
# LEAVE THESE EMPTY LOCALLY. Nobody should put a password in a .env file: with
# sign-in off none of this runs, and with sign-in on locally you can make an
# account with scripts/manage_users.mjs instead.
CRM_RITVARS_PASSWORD=
CRM_AIGARS_PASSWORD=
CRM_ADMISSIONS_PASSWORD=

# A Secure cookie is never sent over plain http, so testing on localhost needs
# this set to 1. Leave it EMPTY on any real host.
CRM_INSECURE_COOKIE=

# --- Google sign-in -------------------------------------------------------
# NOT CONFIGURED ANYWHERE YET, 25.09.2026. The code is built and tested against
# a locally generated key pair; no OAuth client exists for the Academy CRM and
# no redirect URI is registered with Google. Until all three are set, the
# "Continue with Google" button is not drawn at all and /api/auth/google/start
# answers 503 google_not_configured.
#
# Registering the redirect URI at Google Cloud Console must happen BEFORE these
# are filled in: Google compares redirect_uri character for character and
# refuses on its own error page, before any of our code runs, so a wrong value
# leaves no trace on our side to debug.
#
# Only a verified @novikontas.org address WITH a crm_users row can sign in.
# Signing in never creates an account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- The shared door, and the copy's own settings -------------------------
# CRM_PUBLIC=1 puts every page behind one shared password. That is NOT sign-in;
# it is the door on a shared testing copy. The server refuses to start as a
# public copy without a password of at least 12 characters, and refuses
# DATASET=real on one entirely.
CRM_PUBLIC=
CRM_ACCESS_PASSWORD=

# empty | demo | synthetic | real
DATASET=
PORT=
